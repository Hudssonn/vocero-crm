# Dominio principal
{$DOMAIN} {
	handle /api/voz/* {
		uri strip_prefix /api
		reverse_proxy 172.18.0.1:8480
	}

	@root path /
	handle @root {
		root * /srv/landing
		file_server
	}

	handle /privacidad {
		root * /srv/landing
		rewrite * /privacidad.html
		file_server
	}

	handle /diagnostico {
		root * /srv/landing
		rewrite * /diagnostico.html
		file_server
	}

	reverse_proxy app:3000 {
		flush_interval -1
	}
		# Buzon de prueba menu QR Soda La Esquina - TEMPORAL (quitar al terminar)
	# Cliente (menu y API) PUBLICO: al escanear el QR no se pide login.
	# Solo pedidos (buzon) y hoja QR (personal) piden contrasena.
	handle /soda {
		redir /soda/ 308
	}
	@pedidos path /soda/pedidos
	handle @pedidos {
		uri strip_prefix /soda
		reverse_proxy 172.18.0.1:18081 {
			flush_interval -1
		}
	}
	@qr path /soda/qr-imprimir.html
	handle @qr {
		uri strip_prefix /soda
		reverse_proxy 172.18.0.1:18081 {
			flush_interval -1
		}
	}
	handle_path /soda/* {
		reverse_proxy 172.18.0.1:18081 {
			flush_interval -1
		}
	}
	encode gzip
}

# Tienda de Empleados Públicos
